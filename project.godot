; Engine configuration file.
config_version=5

[application]

config/name="Crystal Excavator"
config/description="Jogo incremental 3D de mineração de cristais."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="CrystalExcavator"
boot_splash/bg_color=Color(0.03, 0.02, 0.06, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/Core/GameState.cs"
AudioManager="*res://scripts/Audio/AudioManager.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="CrystalExcavator"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.02, 0.015, 0.04, 1)
